# =======================================================
# CẤU HÌNH TELEGRAM BOT
# =======================================================
# Lấy token từ @BotFather trên Telegram
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Telegram ID của bạn để nhận báo cáo lợi nhuận và cảnh báo (Lấy từ @userinfobot)
ADMIN_TELEGRAM_ID=123456789

# =======================================================
# CẤU HÌNH KINH DOANH & LỢI NHUẬN
# =======================================================
# Tỷ lệ lãi (0.20 = 20% mỗi sản phẩm)
PROFIT_MARGIN=0.20

# Tỷ giá ngoại tệ quy đổi sang VND
USD_TO_VND_RATE=25400
RUB_TO_VND_RATE=280

# Chế độ nhà cung cấp:
# - 'mock'     : Chế độ giả lập (khuyên dùng để test toàn bộ luồng mua & nhận tài khoản)
# - 'lzt'      : Sàn quốc tế LZT Market (Lolzteam) - Rẻ nhất thế giới cho ChatGPT, AI
# - 'plati'    : Sàn Plati.Market / Digiseller
# - 'taphoammo': Sàn Tạp Hóa MMO (Việt Nam)
SUPPLIER_TYPE=mock

# =======================================================
# CẤU HÌNH THANH TOÁN VIETQR & SEPAY
# =======================================================
# Tên mã ngân hàng nhận tiền (MBBank, VCB, ACB, TPBank, VPBank, Techcombank...)
BANK_ID=MBBank
# Số tài khoản ngân hàng của bạn
BANK_ACCOUNT_NO=0987654321
# Tên chủ tài khoản (viết hoa không dấu)
BANK_ACCOUNT_NAME=NGUYEN VAN A

# Webhook SePay (Đăng ký tài khoản miễn phí tại sepay.vn)
SEPAY_API_KEY=your_sepay_api_key_here
SEPAY_WEBHOOK_SECRET=your_sepay_webhook_secret_here

# Port chạy Webhook Server tiếp nhận biến động số dư
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# =======================================================
# API KEYS NHÀ CUNG CẤP NGUỒN HÀNG (KHI KẾT NỐI THẬT)
# =======================================================
# LZT Market Token (Lấy tại: https://market.lolz.live/account/api)
LZT_API_TOKEN=your_lzt_token_here

# Plati / Digiseller API (Lấy tại: https://my.digiseller.com)
DIGISELLER_SELLER_ID=your_seller_id_here
DIGISELLER_API_KEY=your_digiseller_api_key_here

# Tạp Hóa MMO API (Lấy tại: https://taphoammo.net)
TAPHOAMMO_API_KEY=your_taphoammo_api_key_here

# =======================================================
# CẤU HÌNH USERBOT (KHI SUPPLIER_TYPE=userbot)
# =======================================================
# Lấy từ https://my.telegram.org
USERBOT_API_ID=
USERBOT_API_HASH=
# Chuỗi đăng nhập sinh ra từ lệnh: python userbot_login.py
USERBOT_SESSION_STRING=
# Bot nguồn cần mua tự động
TARGET_BOT_USERNAME=SupremeLeaderShopBot
